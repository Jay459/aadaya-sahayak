NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://aadaya:local-development-only@127.0.0.1:5432/aadaya
# Optional direct connection for Neon migrations and seed (no -pooler hostname).
DATABASE_URL_UNPOOLED=
# Use a PostgreSQL URL with verified TLS for remote databases. Never disable certificate validation.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Required only by the seed command. Use a unique password; never use real citizen data.
DEMO_PASSWORD=
# Set only behind a known, single reverse proxy; otherwise leave at 0.
TRUST_PROXY_HOPS=0
